{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "nexus-api-gen input schema",
  "description": "Schema for the YAML input consumed by nexus-api-gen. Language selectors such as $python and $typescript may appear anywhere; the generator projects the YAML for the selected language before parsing the resulting document into one spec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nexusrpc", "services"],
  "properties": {
    "nexusrpc": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the Nexus RPC input format."
    },
    "support": {
      "$ref": "#/$defs/scopedString"
    },
    "types": {
      "$ref": "#/$defs/typeOverrides"
    },
    "services": {
      "$ref": "#/$defs/services"
    }
  },
  "$defs": {
    "selectorPattern": {
      "type": "string",
      "pattern": "^\\$(dotnet|go|java|python|ruby|typescript)$"
    },
    "node": {
      "description": "Recursive YAML node. Known language selectors may appear anywhere and are projected away before parsing.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!\\$).*|^\\$(dotnet|go|java|python|ruby|typescript)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        }
      ]
    },
    "hasLanguageSelector": {
      "anyOf": [
        {
          "required": ["$dotnet"]
        },
        {
          "required": ["$go"]
        },
        {
          "required": ["$java"]
        },
        {
          "required": ["$python"]
        },
        {
          "required": ["$ruby"]
        },
        {
          "required": ["$typescript"]
        }
      ]
    },
    "scopedStringSelectors": {
      "type": "object",
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/scopedString"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/hasLanguageSelector"
        }
      ]
    },
    "scopedString": {
      "description": "A string value or a language-scoped object that resolves to one after projection.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/scopedStringSelectors"
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "languageNodeProperties": {
      "type": "object",
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    },
    "service": {
      "type": "object",
      "required": ["endpoint", "operations"],
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/scopedString"
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {
          "$ref": "#/$defs/scopedString"
        },
        "output": {
          "$ref": "#/$defs/operationOutput"
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "operationOutput": {
      "description": "After projection this resolves either to a string ref or to an object with `ref` plus optional `type` and `transform`.",
      "anyOf": [
        {
          "$ref": "#/$defs/scopedString"
        },
        {
          "$ref": "#/$defs/operationOutputObject"
        }
      ]
    },
    "operationOutputObject": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/scopedString"
        },
        "type": {
          "$ref": "#/$defs/scopedString"
        },
        "transform": {
          "$ref": "#/$defs/scopedString"
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/operationOutput"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["ref"]
            },
            {
              "$ref": "#/$defs/hasLanguageSelector"
            }
          ]
        }
      ]
    },
    "typeOverrides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/typeOverride"
      }
    },
    "typeOverride": {
      "type": "object",
      "properties": {
        "required": {
          "$ref": "#/$defs/stringList"
        },
        "omit": {
          "$ref": "#/$defs/stringList"
        },
        "type": {
          "$ref": "#/$defs/scopedString"
        },
        "fromProto": {
          "$ref": "#/$defs/scopedString"
        },
        "toProto": {
          "$ref": "#/$defs/scopedString"
        },
        "fields": {
          "$ref": "#/$defs/fieldOverrides"
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "fieldOverrides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fieldOverride"
      }
    },
    "fieldOverride": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/scopedString"
        },
        "type": {
          "$ref": "#/$defs/scopedString"
        },
        "source": {
          "$ref": "#/$defs/scopedString"
        },
        "function": {
          "$ref": "#/$defs/function"
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["result", "argsField"],
      "properties": {
        "primary": {
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/scopedString"
        },
        "argsField": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^\\$(dotnet|go|java|python|ruby|typescript)$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    }
  }
}
