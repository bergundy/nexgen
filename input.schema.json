{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "nexus-api-gen input schema",
  "description": "Schema for the YAML input consumed by nexus-api-gen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nexusrpc", "services"],
  "properties": {
    "nexusrpc": {
      "type": "string",
      "description": "Version of the Nexus RPC input format.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "support": {
      "$ref": "#/$defs/supportFiles"
    },
    "types": {
      "$ref": "#/$defs/typeOverrides"
    },
    "services": {
      "type": "object",
      "description": "Map of Nexus service names to service definitions.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "operations"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Nexus endpoint used for the generated service client. WorkflowService commonly uses `__temporal_system`."
        },
        "operations": {
          "type": "object",
          "description": "Map of operation names to operation definitions.",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {
          "$ref": "#/$defs/languageRefs"
        },
        "output": {
          "$ref": "#/$defs/operationOutput"
        }
      }
    },
    "operationOutput": {
      "type": "object",
      "description": "Language-specific output refs plus optional generated-client output transforms.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "$dotnetRef": {
          "type": "string",
          "minLength": 1
        },
        "$goRef": {
          "type": "string",
          "minLength": 1
        },
        "$javaRef": {
          "type": "string",
          "minLength": 1
        },
        "$pythonRef": {
          "type": "string",
          "minLength": 1
        },
        "$rubyRef": {
          "type": "string",
          "minLength": 1
        },
        "$typescriptRef": {
          "type": "string",
          "minLength": 1
        },
        "$python": {
          "$ref": "#/$defs/operationOutputTransform"
        },
        "$typescript": {
          "$ref": "#/$defs/operationOutputTransform"
        }
      }
    },
    "operationOutputTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Generated client return type for the transformed operation result."
        },
        "transform": {
          "type": "string",
          "minLength": 1,
          "description": "Language expression that converts `result` into the transformed output value. The request object is available as `request`."
        }
      }
    },
    "supportFiles": {
      "type": "object",
      "description": "Optional language-specific support snippets appended into generated output.",
      "additionalProperties": false,
      "properties": {
        "$pythonFile": {
          "type": "string",
          "minLength": 1
        },
        "$typescriptFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typeOverrides": {
      "type": "object",
      "description": "Optional map of canonical proto message and enum names to generated-type overrides.",
      "additionalProperties": {
        "$ref": "#/$defs/typeOverride"
      }
    },
    "typeOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/modelRequiredFields"
        },
        "omit": {
          "$ref": "#/$defs/modelOmittedFields"
        },
        "$python": {
          "$ref": "#/$defs/pythonTypeOverride"
        },
        "$typescript": {
          "$ref": "#/$defs/typescriptTypeOverride"
        }
      }
    },
    "modelRequiredFields": {
      "type": "array",
      "description": "Optional list of proto field names that should be generated as required. Presence-bearing fields validate with protobuf presence checks; string and bytes fields validate as non-empty values.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "modelOmittedFields": {
      "type": "array",
      "description": "Optional list of proto field names to remove from generated models and operation APIs.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "pythonTypeOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Required language-native replacement type."
        },
        "fromProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        },
        "toProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        },
        "typeParameters": {
          "$ref": "#/$defs/pythonTypeParameters"
        },
        "fields": {
          "$ref": "#/$defs/languageModelFieldOverrides"
        }
      }
    },
    "typescriptTypeOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Required language-native replacement type."
        },
        "fromProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        },
        "toProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        },
        "fields": {
          "$ref": "#/$defs/languageModelFieldOverrides"
        }
      }
    },
    "pythonTypeParameters": {
      "type": "array",
      "description": "Optional inline generic parameters for a generated Python model. These are only valid on generated message models, not on whole-type replacements.",
      "items": {
        "$ref": "#/$defs/pythonTypeParameter"
      },
      "uniqueItems": true
    },
    "pythonTypeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["TypeVar", "TypeVarTuple"]
        }
      }
    },
    "languageModelFieldOverrides": {
      "type": "object",
      "description": "Optional per-field language-specific overrides for a generated message model. `type` changes only the emitted annotation; `source` hides the field from the generated model in that language and provides the serializer expression instead. Python also supports structured `workflow_function` metadata for workflow callable fields.",
      "additionalProperties": {
        "$ref": "#/$defs/languageModelFieldOverride"
      }
    },
    "languageModelFieldOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Exact language annotation to emit for this field."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Language expression used to populate this field during serialization instead of exposing it in the generated model."
        },
        "workflow_function": {
          "$ref": "#/$defs/pythonWorkflowFunctionField"
        }
      }
    },
    "pythonWorkflowFunctionField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args", "result", "argsField"],
      "properties": {
        "args": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the Python `TypeVarTuple` that represents the workflow arguments."
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "description": "Python annotation for the workflow result type. The generated callable annotation wraps this in `collections.abc.Awaitable[...]`."
        },
        "argsField": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the field on the same message that carries the workflow argument tuple."
        }
      }
    },
    "languageRefs": {
      "type": "object",
      "description": "Map of language-specific type references for a request or response.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "$dotnetRef": {
          "type": "string",
          "minLength": 1
        },
        "$goRef": {
          "type": "string",
          "minLength": 1
        },
        "$javaRef": {
          "type": "string",
          "minLength": 1
        },
        "$pythonRef": {
          "type": "string",
          "minLength": 1
        },
        "$rubyRef": {
          "type": "string",
          "minLength": 1
        },
        "$typescriptRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
