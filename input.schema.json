{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "nexus-api-gen input schema",
  "description": "Schema for the YAML input consumed by nexus-api-gen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nexusrpc", "services"],
  "properties": {
    "nexusrpc": {
      "type": "string",
      "description": "Version of the Nexus RPC input format.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "support": {
      "$ref": "#/$defs/supportFiles"
    },
    "types": {
      "$ref": "#/$defs/typeOverrides"
    },
    "services": {
      "type": "object",
      "description": "Map of Nexus service names to service definitions.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "operations"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Nexus endpoint used for the generated service client. WorkflowService commonly uses `__temporal_system`."
        },
        "operations": {
          "type": "object",
          "description": "Map of operation names to operation definitions.",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {
          "$ref": "#/$defs/languageRefs"
        },
        "output": {
          "$ref": "#/$defs/languageRefs"
        }
      }
    },
    "supportFiles": {
      "type": "object",
      "description": "Optional language-specific support snippets appended into generated output.",
      "additionalProperties": false,
      "properties": {
        "$pythonFile": {
          "type": "string",
          "minLength": 1
        },
        "$typescriptFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typeOverrides": {
      "type": "object",
      "description": "Optional map of canonical proto message and enum names to generated-type overrides.",
      "additionalProperties": {
        "$ref": "#/$defs/typeOverride"
      }
    },
    "typeOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/modelRequiredFields"
        },
        "omit": {
          "$ref": "#/$defs/modelOmittedFields"
        },
        "$python": {
          "$ref": "#/$defs/modelLanguageOverride"
        },
        "$typescript": {
          "$ref": "#/$defs/modelLanguageOverride"
        }
      }
    },
    "modelRequiredFields": {
      "type": "array",
      "description": "Optional list of proto field names that should be generated as required. Presence-bearing fields validate with protobuf presence checks; string and bytes fields validate as non-empty values.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "modelOmittedFields": {
      "type": "array",
      "description": "Optional list of proto field names to remove from generated models and operation APIs.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "modelLanguageOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Required language-native replacement type."
        },
        "fromProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        },
        "toProto": {
          "type": "string",
          "minLength": 1,
          "description": "Optional conversion helper symbol. Defaults to a name derived from the proto message."
        }
      }
    },
    "languageRefs": {
      "type": "object",
      "description": "Map of language-specific type references for a request or response.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "$dotnetRef": {
          "type": "string",
          "minLength": 1
        },
        "$goRef": {
          "type": "string",
          "minLength": 1
        },
        "$javaRef": {
          "type": "string",
          "minLength": 1
        },
        "$pythonRef": {
          "type": "string",
          "minLength": 1
        },
        "$rubyRef": {
          "type": "string",
          "minLength": 1
        },
        "$typescriptRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
